#!/usr/bin/env bash

set -euo pipefail

# 固定公开版本,避免依赖上游缓存或复用错误架构的二进制。
CARGO_BUNDLE_VERSION="0.12.0"
if [[ "$(cargo bundle --version 2>/dev/null || true)" == "cargo-bundle v${CARGO_BUNDLE_VERSION}" ]]; then
    echo "cargo-bundle ${CARGO_BUNDLE_VERSION} is already installed."
    exit 0
fi

cargo install --locked --version "=${CARGO_BUNDLE_VERSION}" cargo-bundle
